+import { A } from "@solidjs/router"
+import { createMemo, createSignal, For, Show, type ParentProps } from "solid-js"
+
+const scenarios = [
+  { id: "path", label: "新法律路径", task: "比较可行法律路径，逐项列请求基础、证据、期限、成本及待核事项。" },
+  { id: "evidence", label: "新证据重评", task: "指出新证据影响哪些事实和既有判断，保留未受影响结论及版本差异。" },
+  { id: "collection", label: "取证失败／部分取得", task: "区分已取得、缺失和不能取得的证据，给替代取证路径及部分成果。" },
+  { id: "recovery", label: "裁判到实际回款", task: "区分裁判金额、执行进展与实际回款；法院划转和客户收到的同源款不得重复计算。" },
+  { id: "strategy", label: "客户目标差异策略", task: "按客户的时间、费用、风险和回款目标比较策略，不将检索分数当胜率。" },
+] as const
+
+type Field = "matter" | "objective" | "materials" | "constraints"
+
+/** A local brief editor around the native OpenCode route; it does not own Session state. */
+export function LegalWorkbench(props: ParentProps) {
+  const [expanded, setExpanded] = createSignal(false)
+  const [scenario, setScenario] = createSignal<string>(scenarios[0].id)
+  const [brief, setBrief] = createSignal<Record<Field, string>>({
+    matter: "",
+    objective: "",
+    materials: "",
+    constraints: "",
+  })
+  const [notice, setNotice] = createSignal("")
+  const selected = createMemo(() => scenarios.find((item) => item.id === scenario()) ?? scenarios[0])
+  const text = createMemo(() => {
+    const value = brief()
+    return [
+      `# 法律任务简报：${selected().label}`,
+      `案件／任务名称：${value.matter || "待填写"}`,
+      `客户目标：${value.objective || "待明确"}`,
+      `材料和文件路径：${value.materials || "请先在原生会话中选择材料"}`,
+      `时间、费用、权限及其他约束：${value.constraints || "待明确"}`,
+      "",
+      selected().task,
+      "先读取明确授权的材料，保留文件来源与版本。不能取得或核实的内容标为未核。",
+      "法源参考与预测样本分开；不得将工具成功或测试通过当作案件目标完成。",
+      "本工作台尚未接入 JC／法律 Harness，不声称已完成确定性计算、案件记账或业务准入。",
+      "交付可检查的文书、证据表或策略比较，并列出剩余待核项。",
+    ].join("\n")
+  })
+
+  function update(field: Field, value: string) {
+    setBrief((previous) => ({ ...previous, [field]: value }))
+    setNotice("")
+  }
+
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(text())
+      setNotice("已复制。粘贴到下方原生会话输入框，选择文件、模型与权限后发送。")
+    } catch {
+      setNotice("未能写入剪贴板。请在任务简报框中全选复制，或导出 Markdown。")
+    }
+  }
+
+  function download() {
+    const url = URL.createObjectURL(new Blob([text()], { type: "text/markdown;charset=utf-8" }))
+    const link = document.createElement("a")
+    link.href = url
+    link.download = "jusbench-task-brief.md"
+    link.click()
+    setTimeout(() => URL.revokeObjectURL(url), 0)
+    setNotice("已请求导出 Markdown。请在下载目录确认文件；这不会创建案件记录。")
+  }
+
+  return (
+    <div class="flex min-h-0 flex-1 flex-col" data-testid="legal-workbench">
+      <header class="flex shrink-0 flex-wrap items-center gap-3 border-b border-current/15 px-3 py-2">
+        <strong>JusBench 法律工作台</strong>
+        <span class="text-xs opacity-70">原生会话、文件、模型与权限</span>
+        <button type="button" class="rounded border border-current/20 px-2 py-1" aria-expanded={expanded()} onClick={() => setExpanded(!expanded())}>
+          {expanded() ? "收起任务简报" : "编写法律任务"}
+        </button>
+        <A class="underline" href="/new-session">新建原生任务</A>
+        <A class="underline" href="/settings">设置</A>
+      </header>
+      <Show when={expanded()}>
+        <section class="max-h-[45vh] shrink-0 overflow-auto border-b border-current/15 p-3" aria-label="法律任务简报">
+          <div class="flex flex-wrap gap-2" role="group" aria-label="任务场景">
+            <For each={scenarios}>
+              {(item) => (
+                <button type="button" class="rounded border border-current/20 px-2 py-1" aria-pressed={scenario() === item.id} onClick={() => { setScenario(item.id); setNotice("") }}>
+                  {item.label}{scenario() === item.id ? " ✓" : ""}
+                </button>
+              )}
+            </For>
+          </div>
+          <div class="mt-3 grid gap-3 md:grid-cols-2">
+            <label class="flex flex-col gap-1">案件／任务名称
+              <input class="rounded border border-current/20 bg-transparent p-2" value={brief().matter} onInput={(event) => update("matter", event.currentTarget.value)} />
+            </label>
+            <label class="flex flex-col gap-1">客户目标
+              <input class="rounded border border-current/20 bg-transparent p-2" placeholder="例如尽快回款、保全证据或控制费用" value={brief().objective} onInput={(event) => update("objective", event.currentTarget.value)} />
+            </label>
+            <label class="flex flex-col gap-1">材料和文件路径
+              <textarea class="rounded border border-current/20 bg-transparent p-2" rows={2} value={brief().materials} onInput={(event) => update("materials", event.currentTarget.value)} />
+            </label>
+            <label class="flex flex-col gap-1">约束与授权范围
+              <textarea class="rounded border border-current/20 bg-transparent p-2" rows={2} value={brief().constraints} onInput={(event) => update("constraints", event.currentTarget.value)} />
+            </label>
+          </div>
+          <label class="mt-3 flex flex-col gap-1">任务简报（可全选复制）
+            <textarea class="rounded border border-current/20 bg-transparent p-2" rows={5} readOnly value={text()} />
+          </label>
+          <div class="mt-2 flex flex-wrap items-center gap-3">
+            <button type="button" class="rounded border border-current/20 px-2 py-1" onClick={() => void copy()}>复制到原生会话</button>
+            <button type="button" class="rounded border border-current/20 px-2 py-1" onClick={download}>导出 Markdown</button>
+            <span class="text-xs opacity-70">简报仅保留在当前页面；刷新前请复制或导出。</span>
+          </div>
+          <p class="mt-2 text-xs opacity-70">JC／法律 Harness 尚未接入。现阶段使用原生工具处理材料和文书，计算与记账结果须核验。</p>
+          <p class="mt-2" role="status" aria-live="polite">{notice()}</p>
+        </section>
+      </Show>
+      <main class="flex min-h-0 flex-1 flex-col">{props.children}</main>
+    </div>
+  )
+}
