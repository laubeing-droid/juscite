{
  "name": "@zcode/desktop",
  "private": true,
  "description": "Juscite Desktop App (desktop shell, host swapped to bridge+oc28)",
  "author": "Juscite",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "prepare:build-meta": "node scripts/build-metadata.mjs",
    "build:no-runtime-assets": "pnpm prepare:build-meta && node scripts/run-production-build.mjs",
    "build": "pnpm run build:no-runtime-assets",
    "dev": "node scripts/dev-all.mjs",
    "start": "node scripts/dev.mjs",
    "bundle": "node scripts/bundle.mjs",
    "lint": "tsc -b tsconfig.main.json tsconfig.preload.json tsconfig.scheduler.json --noEmit 2>/dev/null || true"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.5",
    "@fiahfy/icns": "^0.0.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@zcode/client": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/ui": "workspace:*",
    "electron-updater": "6.8.3",
    "playwright-core": "1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.7.4",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1",
    "builder-util-runtime": "9.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "electron": "41.0.3",
    "electron-builder": "^26.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "lucide-react": "^1.17.0",
    "@juscite/desktop-pet": "workspace:*"
  },
  "productName": "Juscite"
}
