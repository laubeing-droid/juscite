{
  "name": "juscite-frontend",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:web": "pnpm --filter @zcode/web dev",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/ui packages/web packages/desktop packages/desktop/tsconfig.host.json",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @zcode/desktop build",
    "test:adversarial": "node --experimental-strip-types tests/adversarial/run-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "msw",
      "protobufjs"
    ]
  },
  "version": "0.1.0"
}
